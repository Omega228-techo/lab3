#include <iostream>
int main() {
    double r = 3.0; // Радіус кола
    double a = 8.0; // Сторона квадрата
    double x = 2.0; // Координата X
    double y = 1.5; // Координата Y
    std::cout << "Параметри: r = " << r << ", a = " << a << std::endl;
    std::cout << "Точка: (" << x << ", " << y << ")" << std::endl;
    bool in_square = (x >= -a/2.0 && x <= a/2.0 && y >= -a/2.0 && y <= a/2.0);
    bool in_circle = (x*x + y*y <= r*r);
    bool is_inside_green = false;
    if (in_square) {
        if (in_circle) {
            if (x >= 0 && y >= 0) is_inside_green = true;
        } else {
            if (x >= 0 && y >= 0 && y <= x) is_inside_green = true;
            else if (x <= 0 && y >= 0 && y >= -x) is_inside_green = true;
            else if (x <= 0 && y <= 0 && y >= x) is_inside_green = true;
        }
    }
    if (is_inside_green) {
        std::cout << "Результат: точка потрапляє в зелену область" << std::endl;
    } else {
        std::cout << "Результат: точка не потрапляє в зелену область" << std::endl;
    }
    return 0;
}
