#include <iostream>
int main() {
    // Підставляємо значення
    double x = 4; 
    std::cout << "Початкове значення x = " << x << std::endl;
    double h_val;
    if (x < 0) {
        h_val = 2 * x;
    } else if (x >= 0 && x < 3) {
        h_val = x;
    } else { // x >= 3
        h_val = 6 - x;
    }
    int h = static_cast<int>(h_val);
    std::cout << "Значення h(x) = " << h << std::endl;
    return 0;
}

